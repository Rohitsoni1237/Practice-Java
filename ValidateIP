package basic;

public class ValidateIP {
    public static void main(String[] args) {

        System.out.println(isValid("192.168.0.0"));
        System.out.println(isValid("192.168.01.0"));
        System.out.println(isValid("255.168.0.0"));
        System.out.println(isValid("192.168.1"));
        System.out.println(isValid("192.168.1."));
        System.out.println(isValid("192.168.1.0"));
    }

    public static boolean isValid(String ip) {
        String[] split = ip.split("\\.");
        if (split.length != 4) {
            return false;
        }
        for (String s : split) {
            if (s.length() >3) {
                return false;
            }
            int i = Integer.parseInt(s);
            if (i < 0 || i > 255) {
                return false;
            }
            if (s.length() > 1 && s.startsWith("0")) {
                return false;
            }
        }
        return true;
    }
}
